{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-app",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Dashboard.csproj",
        "-c",
        "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotrush: Build App",
      "type": "dotrush.task",
      "project": "${workspaceFolder}/Dashboard.csproj",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Solis Dashboard (Avalonia)",
      "type": "shell",
      "command": "dotnet run --project Dashboard",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": "$msCompile"
    }
  ]
}
