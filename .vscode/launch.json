{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Solis Dashboard (DotRush)",
      "type": "coreclr",
      "request": "launch",
      "program": "${command:dotrush.activeTargetPath}",
      "cwd": "${workspaceFolder}/SolisDashboard.App",
      "preLaunchTask": "dotrush: Build",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Solis Dashboard (attach DotRush)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:dotrush.pickProcess}"
    },
    {
      "name": "Solis Dashboard (dotnet path)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-app",
      "program": "${workspaceFolder}/SolisDashboard.App/bin/Debug/net10.0/SolisDashboard.App.dll",
      "cwd": "${workspaceFolder}/SolisDashboard.App",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
