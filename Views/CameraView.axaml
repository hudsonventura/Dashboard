<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dashboard.ViewModels"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
             x:Class="Dashboard.Views.CameraView"
             x:DataType="vm:CameraViewModel"
             Height="{Binding ViewHeight}"
             Width="{Binding ViewWidth}"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">

    <UserControl.Styles>
        <!-- Fullscreen toggle button: hidden by default with smooth opacity transition -->
        <Style Selector="Button.camera-fullscreen-btn">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Reveal button on mouse hover over video container -->
        <Style Selector="Grid.camera-video-container:pointerover Button.camera-fullscreen-btn">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Border Background="#131722" 
            BorderBrush="#2A2E3D" 
            BorderThickness="1" 
            CornerRadius="10" 
            ClipToBounds="True">
        <Grid RowDefinitions="Auto, *, Auto">
            <!-- VIDEO CONTAINER -->
            <Grid Grid.Row="1" Background="#0A0D14" Classes="camera-video-container">

                <Border Background="#1E293B" CornerRadius="4" Padding="4,1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" ZIndex="10">
                    <TextBlock Text="{Binding StatusText}" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{Binding StatusColor}" />
                </Border>
                
                <!-- VIDEO IMAGE DISPLAY -->
                <Image Source="{Binding CurrentFrame}" 
                       Stretch="Uniform" 
                       IsVisible="{Binding IsLive}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" />

                <!-- CONNECTING / PAUSED / ERROR PLACEHOLDER -->
                <Border IsVisible="{Binding !IsLive}" Background="#0D111A">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#1E293B" HorizontalAlignment="Center">
                            <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z" 
                                      Foreground="#64748B" Width="28" Height="28" />
                        </Border>

                        <TextBlock Text="{Binding StatusText}" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#F8FAFC" 
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding ErrorMessage}" 
                                   FontSize="12" 
                                   Foreground="#EF4444" 
                                   HorizontalAlignment="Center" 
                                   TextWrapping="Wrap" 
                                   MaxWidth="400"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <TextBlock Text="FFmpeg RTSP Decoder Active" 
                                   FontSize="11" 
                                   Foreground="#64748B" 
                                   HorizontalAlignment="Center" />

                        <Button Command="{Binding ReconnectCommand}" 
                                Content="Try Reconnecting" 
                                Background="#2563EB" 
                                Foreground="White" 
                                CornerRadius="6" 
                                Padding="6,3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- HOVER FULLSCREEN TOGGLE BUTTON IN BOTTOM RIGHT CORNER INSIDE VIDEO -->
                <Button Command="{Binding ToggleExpandCommand}"
                        Classes="camera-fullscreen-btn"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="10"
                        ZIndex="20"
                        Background="#D90F172A"
                        BorderBrush="#38BDF8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5"
                        Cursor="Hand"
                        ToolTip.Tip="Toggle Full Screen Camera View">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="⛶" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="Full Screen" FontSize="10" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
