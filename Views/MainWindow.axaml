<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dashboard.ViewModels"
        xmlns:views="using:Dashboard.Views"
        xmlns:models="using:Dashboard.Models"
        xmlns:vmprogress="using:Dashboard.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        x:Class="Dashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1380" Height="880"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- CURRENT TIME -->
        <!-- <Border Background="#1E293B" CornerRadius="6" Padding="12,6">
            <TextBlock Text="{Binding CurrentTimeText}" 
                        FontSize="13" 
                        FontWeight="Bold" 
                        Foreground="#38BDF8" 
                        FontFamily="Monospace, Consolas, Courier New" />
        </Border> -->

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Row="1" Margin="8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- DUAL VIEW: 70% ESQUERDA (CÂMERA PRINCIPAL + SOLIS) / 30% DIREITA (CÂMERA SECUNDÁRIA + WEATHER + MONITOR) -->
                <Grid IsVisible="{Binding IsDualView}" ColumnDefinitions="7*, 8, 3*">
                    
                    <!-- COLUNA ESQUERDA (70% DE LARGURA) -->
                    <StackPanel Grid.Column="0" Spacing="8">

                        <!-- TOPO: CÂMERA PRINCIPAL E WEATHER, DENTRO DOS 70% -->
                        <Grid ColumnDefinitions="Auto, 8, *">
                            <!-- A largura da câmera vem da altura configurada e da proporção do vídeo. -->
                            <views:CameraView Grid.Column="0" DataContext="{Binding PrimaryCamera}" />

                            <!-- PAINEL WEATHER -->
                            <Border Grid.Column="2"
                                    Background="#131722" 
                                    BorderBrush="#2A2E3D" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="10"
                                    Height="{Binding PrimaryCamera.ViewHeight}"
                                    VerticalAlignment="Top">
                                <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
                                    <!-- HEADER WEATHER -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="6" Background="#0284C7">
                                                <Image Source="{Binding WeatherIcon}"
                                                       Width="{Binding WeatherHeaderIconSize}"
                                                       Height="{Binding WeatherHeaderIconSize}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Weather" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                                <TextBlock Text="{Binding WeatherLocationText}" FontSize="9" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="5,2">
                                                <TextBlock Text="{Binding WeatherProviderText}" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                            </Border>
                                            <Button Command="{Binding FetchWeatherCommand}" Background="#1E293B" Foreground="#F8FAFC" CornerRadius="4" Padding="5,2" ToolTip.Tip="Refresh Weather">
                                                <TextBlock Text="🔄" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- WEATHER ALERT BANNER (METEOCONS 2.1 ALERT ICON) -->
                                    <Border Grid.Row="1" 
                                            IsVisible="{Binding HasWeatherAlerts}"
                                            Background="#381E1E" 
                                            BorderBrush="#EF4444" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="6,4" 
                                            Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Image Grid.Column="0" 
                                                   Source="{Binding PrimaryWeatherAlert.Icon}" 
                                                   Width="22" Height="22" 
                                                   Stretch="Uniform" 
                                                   Margin="0,0,6,0" 
                                                   VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrimaryWeatherAlert.Title}" 
                                                           FontSize="9.5" 
                                                           FontWeight="Bold" 
                                                           Foreground="#FCA5A5" />
                                                <TextBlock Text="{Binding PrimaryWeatherAlert.Message}" 
                                                           FontSize="8.5" 
                                                           Foreground="#FECACA" 
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- HERO WEATHER CARD -->
                                    <Border Grid.Row="2" Background="#1A2234" BorderBrush="#26334D" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                        <Grid RowDefinitions="Auto, 6, Auto">
                                            <!-- TOP: LARGE ICON + FAHRENHEIT / CELSIUS TEMPS + CONDITION -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Image Source="{Binding WeatherIcon}"
                                                           Width="{Binding WeatherPanelIconSize}"
                                                           Height="{Binding WeatherPanelIconSize}"
                                                           Stretch="Uniform"
                                                           VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <!-- TEMPERATURA FAHRENHEIT COM CELSIUS AO LADO -->
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding WeatherCurrentTempFahrenheitText}" 
                                                                       FontSize="23" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#F8FAFC" />
                                                            
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding WeatherCurrentTempCelsiusText}" 
                                                                       FontSize="12" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="#64748B" 
                                                                       VerticalAlignment="Bottom"
                                                                       Margin="0,0,0,3" />
                                                        <TextBlock Text="{Binding WeatherConditionText}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                                                        
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- <TextBlock Grid.Column="2" 
                                                           Text="{Binding WeatherLastUpdatedText}" 
                                                           FontSize="9" 
                                                           Foreground="#475569" 
                                                           VerticalAlignment="Top" /> -->
                                            </Grid>

                                            <!-- BOTTOM: GRID DE MÉTRICAS ADICIONAIS -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="4" ColumnSpacing="5">
                                                <!-- FEELS LIKE -->
                                                <Border Grid.Row="0" Grid.Column="0" Background="#111827" CornerRadius="5" Padding="5,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="🌡️" FontSize="15" VerticalAlignment="Center" />
                                                         <StackPanel VerticalAlignment="Center">
                                                             <TextBlock Text="Feels Like" FontSize="12" Foreground="#64748B" />
                                                             <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                 <TextBlock Text="{Binding WeatherFeelsLikeFahrenheitText}" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" />
                                                                 
                                                             </StackPanel>
                                                             <TextBlock Text="{Binding WeatherFeelsLikeCelsiusText}" FontSize="12" FontWeight="Normal" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,0.5" />
                                                         </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- WIND -->
                                                <Border Grid.Row="0" Grid.Column="1" Background="#111827" CornerRadius="5" Padding="5,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="💨" FontSize="11" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Wind" FontSize="12" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding WeatherWindSpeedText}" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- HUMIDITY -->
                                                <Border Grid.Row="1" Grid.Column="0" Background="#111827" CornerRadius="5" Padding="5,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://Dashboard/Assets/Meteocons/png/humidity.png"
                                                               Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Humidity" FontSize="12" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding WeatherCurrentHumidityText}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- RAIN 24H -->
                                                <Border Grid.Row="1" Grid.Column="1" Background="#111827" CornerRadius="5" Padding="5,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://Dashboard/Assets/Meteocons/png/rain.png"
                                                               Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Rain 24h" FontSize="12" Foreground="#64748B" />
                                                            <TextBlock Text="{Binding WeatherPrecipitationProbabilityText}" FontSize="15" FontWeight="Bold" Foreground="#60A5FA" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- HIGH / LOW TODAY -->
                                    <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="5" Margin="0,0,0,6">
                                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="5,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="↑" FontSize="13" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" />
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="High Today" FontSize="8" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding WeatherTodayMaxText}" FontSize="10.5" FontWeight="Bold" Foreground="#F87171" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="5,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="↓" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="Low Today" FontSize="8" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding WeatherTodayMinText}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- FORECAST 3 DIAS -->
                                    <ItemsControl Grid.Row="4" ItemsSource="{Binding ForecastDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DailyForecast">
                                                <Border Background="#182030" 
                                                        BorderBrush="#263147" 
                                                        BorderThickness="1" 
                                                        CornerRadius="6" 
                                                        Padding="3,2"
                                                        Margin="1">
                                                    <StackPanel Spacing="1" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DayOfWeek}"
                                                                   FontSize="9.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#E0F2FE"
                                                                   HorizontalAlignment="Center" />
                                                        <Image Source="{Binding Icon}"
                                                               Width="{Binding $parent[Window].DataContext.WeatherForecastIconSize}"
                                                               Height="{Binding $parent[Window].DataContext.WeatherForecastIconSize}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />

                                                        <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding TempMax, StringFormat='{}{0:F0}°'}" 
                                                                       FontSize="9.5" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#F97316" />
                                                            <TextBlock Text="/" FontSize="9.5" Foreground="#475569" />
                                                            <TextBlock Text="{Binding TempMin, StringFormat='{}{0:F0}°'}" 
                                                                       FontSize="9.5" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#38BDF8" />
                                                        </StackPanel>

                                                        <!-- CONDIÇÃO DO DIA CONSOANTE AO ÍCONE -->
                                                        <TextBlock Text="{Binding ConditionText}" 
                                                                   FontSize="8" 
                                                                   Foreground="#94A3B8" 
                                                                   HorizontalAlignment="Center" 
                                                                   TextTrimming="CharacterEllipsis" 
                                                                   MaxWidth="90"
                                                                   ToolTip.Tip="{Binding ConditionText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- PAINEL SOLIS (70% LARGURA - ABAIXO DA CÂMERA PRINCIPAL) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="9">
                            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="5">
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,7">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">


                                        

                                        <Border Width="28" Height="28" CornerRadius="6" Background="#F59E0B">
                                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Solar Data"
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#F8FAFC" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="{Binding SolisStateText}" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                        <Button Command="{Binding RefreshSolisCommand}" IsEnabled="{Binding !IsSolisLoading}"
                                                Background="#1E293B" Foreground="#F8FAFC" CornerRadius="4" Padding="3,1"
                                                ToolTip.Tip="Refresh Solis Data">
                                            <TextBlock Text="🔄" FontSize="10" />
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Image Source="{Binding SolisTimeIcon}"
                                                   Width="{Binding SolisTimeIconSize}"
                                                   Height="{Binding SolisTimeIconSize}"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SolisLocalDateText}" FontSize="16" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            <TextBlock Text="{Binding SolisLocalTimeText}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="42*,58*" ColumnSpacing="6">
                                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                                            <StackPanel HorizontalAlignment="Left" Spacing="0">
                                                <TextBlock Text="Power" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SolisPowerText}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" />
                                                <!-- <TextBlock Text="{Binding SolisInverterModelText}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                                <TextBlock FontSize="10" Foreground="#94A3B8">
                                                    <Run Text="{Binding SolisInverterSnText}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding SolisStateText}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding SolisLastUpdatedText}" FontSize="9" Foreground="#64748B" /> -->
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="0">
                                                <TextBlock Text="Generation" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SolisEnergyTodayText}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Daily Generation" FontSize="10" Foreground="#94A3B8" />
                                                <TextBlock Grid.Column="1" Text="{Binding SolisGenerationProgressText}" FontSize="9" Foreground="#94A3B8" />
                                            </Grid>
                                            <Grid Height="6" Margin="0,2">
                                                <!-- BACKGROUND OVER-TARGET PROGRESS BAR (YELLOW) -->
                                                <ProgressBar Value="{Binding SolarTotalProgressValue}" 
                                                             Maximum="40" 
                                                             Height="6" 
                                                             Background="#394250" 
                                                             Foreground="#F59E0B" 
                                                             IsIndeterminate="{Binding IsSolarProgressAnimated}" />

                                                <!-- FOREGROUND TARGET PROGRESS BAR (GREEN) -->
                                                <ProgressBar Value="{Binding SolarGreenProgressValue}" 
                                                             Maximum="40" 
                                                             Height="6" 
                                                             Background="Transparent" 
                                                             Foreground="#4ADE80" 
                                                             IsIndeterminate="{Binding IsSolarProgressAnimated}" />
                                            </Grid>
                                        </StackPanel>

                                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="3">
                                            <Border Background="#1E293B" CornerRadius="7" Padding="4">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="PV1" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisPv1PowerText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding SolisPv1DetailText}" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="7" Padding="4">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="PV2" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisPv2PowerText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding SolisPv2DetailText}" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="7" Padding="4">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="AC Power" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisPowerText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding SolisAcCurrentText}" FontSize="9" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                                             <Border Background="#1E293B" CornerRadius="7" Padding="4">
                                                 <StackPanel Spacing="0.5">
                                                     <TextBlock Text="IGBT" FontSize="9" Foreground="#94A3B8" />
                                                     <TextBlock Text="{Binding SolisIgbtTemperatureText}" Foreground="{Binding SolisIgbtTemperatureColor}" Opacity="{Binding SolisIgbtTemperatureOpacity}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                 </StackPanel>
                                             </Border>
                                             
                                            <StackPanel Grid.Column="2" Spacing="0.5" VerticalAlignment="Center">
                                                <TextBlock Text="1st ≥ 6 kW" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding SolisFirst6KwText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="0.5" VerticalAlignment="Center">
                                                <TextBlock Text="Last ≥ 6 kW" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding SolisLast6KwText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <DockPanel Grid.Column="1" MinHeight="230">
                                        <lvc:CartesianChart Series="{Binding SolarChartSeries}"
                                                            XAxes="{Binding SolarChartXAxes}"
                                                            YAxes="{Binding SolarChartYAxes}"
                                                            LegendPosition="Hidden"
                                                            ZoomMode="None" />
                                    </DockPanel>
                                </Grid>


                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- COLUNA DIREITA (30% DE LARGURA) -->
                    <StackPanel Grid.Column="2" Spacing="8">
                        
                        <!-- CÂMERA SECUNDÁRIA (30% LARGURA - HEIGHT 180px) -->
                        <views:CameraView DataContext="{Binding SecondaryCamera}" />

                        

                        <!-- MONITOR DO SISTEMA (ABAIXO DO PAINEL WEATHER) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="8">
                            <StackPanel Spacing="4.5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="#7DD3FC" />
                                     <TextBlock Grid.Column="1" Text="{Binding SysCpuTemperatureText}" Foreground="{Binding SysCpuTemperatureColor}" Opacity="{Binding SysCpuTemperatureOpacity}" FontSize="12" FontWeight="Bold" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding CpuCores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CpuUsageViewModel">
                                            <Grid ColumnDefinitions="38, *, 42" Margin="0,0.5">
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#93C5FD" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Value="{Binding Usage}" Maximum="100" Height="3" Background="#394250"
                                                             Foreground="{Binding BarColor}" Classes.critical="{Binding IsCritical}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding UsageText}" FontSize="10" FontWeight="SemiBold" Foreground="#E0F2FE" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="1.5" Margin="0,2,0,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Memory" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding SysMemoryUsageText}" FontSize="10" FontWeight="SemiBold" Foreground="#E0F2FE" />
                                    </Grid>
                                    <ProgressBar Value="{Binding SysMemoryUsage}" Maximum="100" Height="6" Background="#394250"
                                                 Foreground="{Binding SysMemoryBarColor}" Classes.critical="{Binding IsMemoryCritical}" />
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,1,0,0">
                                        <TextBlock Text="Swap" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding SysSwapUsageText}" FontSize="10" FontWeight="SemiBold" Foreground="#FB7185" />
                                    </Grid>
                                    <ProgressBar Value="{Binding SysSwapUsage}" Maximum="100" Height="6" Background="#394250" Foreground="#FB7185" />
                                </StackPanel>

                                <TextBlock Text="Disks" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" />
                                <ItemsControl ItemsSource="{Binding SystemDisks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiskUsageViewModel">
                                            <Border Background="#1E293B" CornerRadius="6" Padding="4" Margin="0,1">
                                                <StackPanel Spacing="1.5">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="9" FontWeight="SemiBold" Foreground="#E0F2FE" />
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Usage}" Maximum="100" Height="3" Background="#394250"
                                                                 Foreground="{Binding BarColor}" Classes.critical="{Binding IsCritical}" />
                                                    <Grid ColumnDefinitions="*, Auto">
                                                         <TextBlock Text="{Binding TemperatureText}" Foreground="{Binding TemperatureColor}" Opacity="{Binding TemperatureOpacity}" FontSize="8" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SmartStatusText}" FontSize="8" FontWeight="SemiBold"
                                                                   Foreground="{Binding SmartStatusColor}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

                <!-- SINGLE EXPANDED CAMERA VIEW -->
                <Grid IsVisible="{Binding !IsDualView}">
                    <views:CameraView DataContext="{Binding FocusedCamera}" 
                                      VerticalAlignment="Stretch" 
                                      HorizontalAlignment="Stretch" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- BURN-IN COLOR INVERSION OVERLAY -->
        <Border Grid.RowSpan="3"
                IsVisible="{Binding IsColorsInverted}"
                Background="#EEFFFFFF"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="9998" />

        <!-- BURN-IN FLASH OVERLAY (WHITE / BLACK) -->
        <Border Grid.RowSpan="3"
                IsVisible="{Binding IsBurnInOverlayVisible}"
                Background="{Binding BurnInOverlayColor}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="9999" />
    </Grid>
</Window>
