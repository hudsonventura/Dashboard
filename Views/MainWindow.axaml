<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dashboard.ViewModels"
        xmlns:views="using:Dashboard.Views"
        xmlns:models="using:Dashboard.Models"
        xmlns:vmprogress="using:Dashboard.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        x:Class="Dashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1380" Height="880"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- CURRENT TIME -->
        <!-- <Border Background="#1E293B" CornerRadius="6" Padding="12,6">
            <TextBlock Text="{Binding CurrentTimeText}" 
                        FontSize="13" 
                        FontWeight="Bold" 
                        Foreground="#38BDF8" 
                        FontFamily="Monospace, Consolas, Courier New" />
        </Border> -->

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Row="1" Margin="16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- DUAL VIEW: 70% ESQUERDA (CÂMERA PRINCIPAL + SOLIS) / 30% DIREITA (CÂMERA SECUNDÁRIA + WEATHER + MONITOR) -->
                <Grid IsVisible="{Binding IsDualView}" ColumnDefinitions="7*, 16, 3*">
                    
                    <!-- COLUNA ESQUERDA (70% DE LARGURA) -->
                    <StackPanel Grid.Column="0" Spacing="16">

                        <!-- TOPO: CÂMERA PRINCIPAL E WEATHER, DENTRO DOS 70% -->
                        <Grid ColumnDefinitions="Auto, 16, *">
                            <!-- A largura da câmera vem da altura configurada e da proporção do vídeo. -->
                            <views:CameraView Grid.Column="0" DataContext="{Binding PrimaryCamera}" />

                            <!-- PAINEL WEATHER -->
                            <Border Grid.Column="2"
                                Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="16"
                                Height="{Binding PrimaryCamera.ViewHeight}"
                                VerticalAlignment="Top">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <!-- HEADER WEATHER -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#0284C7">
                                            <Image Source="{Binding WeatherIcon}"
                                                   Width="{Binding WeatherHeaderIconSize}"
                                                   Height="{Binding WeatherHeaderIconSize}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Weather" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,3">
                                            <TextBlock Text="{Binding WeatherProviderText}" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                        </Border>
                                        <Button Command="{Binding FetchWeatherCommand}" Background="#1E293B" Foreground="#F8FAFC" CornerRadius="4" Padding="6,2" ToolTip.Tip="Atualizar Clima">
                                            <TextBlock Text="🔄" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- LINHA 1: TEMPERATURA E UMIDADE ATUAIS NA MESMA LINHA -->
                                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <Grid RowDefinitions="Auto, 8, Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Image Source="{Binding WeatherIcon}"
                                                   Width="{Binding WeatherPanelIconSize}"
                                                   Height="{Binding WeatherPanelIconSize}"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- TEMPERATURA -->
                                                    <TextBlock Text="{Binding WeatherCurrentTempText}" 
                                                               FontSize="18" 
                                                               FontWeight="Bold" 
                                                               Foreground="#F8FAFC" />
                                                    <TextBlock Text="|" FontSize="16" Foreground="#475569" Margin="2,0" />
                                                    <!-- UMIDADE -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Image Source="avares://Dashboard/Assets/Meteocons/png/humidity.png"
                                                               Width="{Binding WeatherInfoIconSize}"
                                                               Height="{Binding WeatherInfoIconSize}"
                                                               Stretch="Uniform"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding WeatherCurrentHumidityText}" 
                                                                   FontSize="15" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="#38BDF8" 
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WeatherConditionText}" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding WeatherLastUpdatedText}" 
                                                   FontSize="9" 
                                                   Foreground="#64748B" 
                                                   VerticalAlignment="Bottom" />
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="↑" FontSize="16" FontWeight="Bold" Foreground="#F87171" />
                                            <StackPanel Spacing="0">
                                                <TextBlock Text="High" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding WeatherTodayMaxText}" FontSize="11" FontWeight="Bold" Foreground="#F87171" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="↓" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" />
                                            <StackPanel Spacing="0">
                                                <TextBlock Text="Low" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding WeatherTodayMinText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                            <Image Source="avares://Dashboard/Assets/Meteocons/png/rain.png"
                                                   Width="18"
                                                   Height="18"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center" />
                                            <StackPanel Spacing="0">
                                                <TextBlock Text="Rain 24h" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding WeatherPrecipitationProbabilityText}" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                </Border>

                                <!-- LINHA 2: MÁXIMA E MÍNIMA PARA OS PRÓXIMOS 4 DIAS -->
                                <StackPanel Grid.Row="2" Spacing="6">
                                    
                                    <ItemsControl ItemsSource="{Binding ForecastDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DailyForecast">
                                                <Border Background="#182030" 
                                                        BorderBrush="#263147" 
                                                        BorderThickness="1" 
                                                        CornerRadius="6" 
                                                        Padding="2" 
                                                        Margin="1">
                                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DayOfWeek}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#E0F2FE"
                                                                   HorizontalAlignment="Center" />
                                                        <Image Source="{Binding Icon}"
                                                               Width="{Binding $parent[Window].DataContext.WeatherForecastIconSize}"
                                                               Height="{Binding $parent[Window].DataContext.WeatherForecastIconSize}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center" />

                                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding TempMax, StringFormat='{}{0:F0}°'}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#F97316" />
                                                            <TextBlock Text="/" FontSize="10" Foreground="#475569" />
                                                            <TextBlock Text="{Binding TempMin, StringFormat='{}{0:F0}°'}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#38BDF8" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                            </Border>
                        </Grid>

                        <!-- PAINEL SOLIS (70% LARGURA - ABAIXO DA CÂMERA PRINCIPAL) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="18">
                            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">


                                        

                                        <Border Width="28" Height="28" CornerRadius="6" Background="#F59E0B">
                                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Solar Data"
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#F8FAFC" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding SolisStateText}" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                        <Button Command="{Binding RefreshSolisCommand}" IsEnabled="{Binding !IsSolisLoading}"
                                                Background="#1E293B" Foreground="#F8FAFC" CornerRadius="4" Padding="6,2"
                                                ToolTip.Tip="Atualizar dados do Solis">
                                            <TextBlock Text="🔄" FontSize="10" />
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Image Source="{Binding SolisTimeIcon}"
                                                   Width="{Binding SolisTimeIconSize}"
                                                   Height="{Binding SolisTimeIconSize}"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SolisLocalDateText}" FontSize="16" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            <TextBlock Text="{Binding SolisLocalTimeText}" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="42*,58*" ColumnSpacing="12">
                                    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding SolisInverterModelText}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" />
                                                <TextBlock FontSize="10" Foreground="#94A3B8">
                                                    <Run Text="{Binding SolisInverterSnText}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding SolisStateText}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding SolisLastUpdatedText}" FontSize="9" Foreground="#64748B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="0">
                                                <TextBlock Text="Geração" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding SolisEnergyTodayText}" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Geração diária" FontSize="10" Foreground="#94A3B8" />
                                                <TextBlock Grid.Column="1" Text="{Binding SolisGenerationProgressText}" FontSize="9" Foreground="#94A3B8" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding SolarGenerationProgressSegments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="40" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vmprogress:SolarProgressSegment">
                                                        <Border Height="15" Margin="1,0" CornerRadius="2"
                                                                Background="{Binding Fill}"
                                                                BorderBrush="{Binding Border}"
                                                                BorderThickness="{Binding BorderThickness}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="33*,7*">
                                                <TextBlock Text="100% · 33 kWh" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#F59E0B" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="1" Text="40 kWh" FontSize="9" Foreground="#64748B"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>

                                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                            <Border Background="#1E293B" CornerRadius="7" Padding="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="PV1" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisPv1PowerText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding SolisPv1DetailText}" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="7" Padding="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="PV2" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisPv2PowerText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding SolisPv2DetailText}" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="7" Padding="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="AC Potência" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisPowerText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding SolisAcCurrentText}" FontSize="9" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                            <Border Background="#1E293B" CornerRadius="7" Padding="8">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="IGBT" FontSize="9" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisIgbtTemperatureText}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="7" Padding="8">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Temp. inversor" FontSize="9" Foreground="#94A3B8" />
                                                    <TextBlock Text="{Binding SolisTemperatureText}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="1º ≥ 6 kW" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding SolisFirst6KwText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="Último ≥ 6 kW" FontSize="9" Foreground="#94A3B8" />
                                                <TextBlock Text="{Binding SolisLast6KwText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <DockPanel Grid.Column="1" MinHeight="230">
                                        <lvc:CartesianChart Series="{Binding SolarChartSeries}"
                                                            XAxes="{Binding SolarChartXAxes}"
                                                            YAxes="{Binding SolarChartYAxes}"
                                                            LegendPosition="Hidden"
                                                            ZoomMode="None" />
                                    </DockPanel>
                                </Grid>


                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- COLUNA DIREITA (30% DE LARGURA) -->
                    <StackPanel Grid.Column="2" Spacing="16">
                        
                        <!-- CÂMERA SECUNDÁRIA (30% LARGURA - HEIGHT 180px) -->
                        <views:CameraView DataContext="{Binding SecondaryCamera}" />

                        

                        <!-- MONITOR DO SISTEMA (ABAIXO DO PAINEL WEATHER) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="16">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="#7DD3FC" />
                                    <TextBlock Grid.Column="1" Text="{Binding SysCpuTemperatureText}" FontSize="12" FontWeight="Bold" Foreground="#FBBF24" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding CpuCores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CpuUsageViewModel">
                                            <Grid ColumnDefinitions="38, *, 42" Margin="0,1">
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#93C5FD" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Value="{Binding Usage}" Maximum="100" Height="3" Background="#394250"
                                                             Foreground="{Binding BarColor}" Classes.critical="{Binding IsCritical}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding UsageText}" FontSize="10" FontWeight="SemiBold" Foreground="#E0F2FE" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="3" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Memória" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding SysMemoryUsageText}" FontSize="10" FontWeight="SemiBold" Foreground="#E0F2FE" />
                                    </Grid>
                                    <ProgressBar Value="{Binding SysMemoryUsage}" Maximum="100" Height="6" Background="#394250"
                                                 Foreground="{Binding SysMemoryBarColor}" Classes.critical="{Binding IsMemoryCritical}" />
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                        <TextBlock Text="Swap" FontSize="10" Foreground="#94A3B8" />
                                        <TextBlock Grid.Column="1" Text="{Binding SysSwapUsageText}" FontSize="10" FontWeight="SemiBold" Foreground="#FB7185" />
                                    </Grid>
                                    <ProgressBar Value="{Binding SysSwapUsage}" Maximum="100" Height="6" Background="#394250" Foreground="#FB7185" />
                                </StackPanel>

                                <TextBlock Text="Discos" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding SystemDisks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiskUsageViewModel">
                                            <Border Background="#1E293B" CornerRadius="6" Padding="8" Margin="0,2">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" FontSize="9" FontWeight="SemiBold" Foreground="#E0F2FE" />
                                                    </Grid>
                                                    <ProgressBar Value="{Binding Usage}" Maximum="100" Height="3" Background="#394250"
                                                                 Foreground="{Binding BarColor}" Classes.critical="{Binding IsCritical}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

                <!-- SINGLE EXPANDED CAMERA VIEW -->
                <Grid IsVisible="{Binding !IsDualView}">
                    <views:CameraView DataContext="{Binding FocusedCamera}" 
                                      VerticalAlignment="Stretch" 
                                      HorizontalAlignment="Stretch" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER STATUS BAR -->
        <!-- <Border Grid.Row="2" Background="#0E121B" BorderBrush="#1F2433" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" 
                           Text="{Binding ConfigStatusMessage}" 
                           FontSize="12" 
                           Foreground="#94A3B8" 
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="[Ctrl+Enter] Tela Cheia | [ESC / Botão Direito] Sair" 
                                   FontSize="11" 
                                   Foreground="#38BDF8" 
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Config: appsettings.json" FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="Framework: Avalonia .NET 10" FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </Grid>
        </Border> -->
    </Grid>
</Window>
