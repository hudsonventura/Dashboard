<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dashboard.ViewModels"
        xmlns:views="using:Dashboard.Views"
        xmlns:models="using:Dashboard.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        x:Class="Dashboard.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="1380" Height="880"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- TOP APP HEADER -->
        <Border Grid.Row="0" Background="#131722" BorderBrush="#1F2433" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <!-- TITLE & BRANDING -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#2563EB">
                        <TextBlock Text="📹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MONITOR DE CÂMERAS RTSP &amp; DASHBOARD" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="#F8FAFC" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Engine: FFmpeg (Sem VLC)" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                            <TextBlock Text="|" FontSize="11" Foreground="#475569" />
                            <TextBlock Text="Linux Native" FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- HEADER ACTIONS & CLOCK -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    
                    <!-- CURRENT TIME -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding CurrentTimeText}" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   Foreground="#38BDF8" 
                                   FontFamily="Monospace, Consolas, Courier New" />
                    </Border>

                    <!-- RESTORE DUAL VIEW BUTTON -->
                    <Button Command="{Binding RestoreDualViewCommand}" 
                            IsVisible="{Binding !IsDualView}"
                            Background="#3B82F6" 
                            Foreground="White" 
                            CornerRadius="6" 
                            Padding="12,6">
                        <TextBlock Text="Ver Duas Câmeras" FontSize="12" FontWeight="Bold" />
                    </Button>

                    <!-- RELOAD CONFIG BUTTON -->
                    <Button Command="{Binding LoadConfigurationCommand}" 
                            Background="#1E293B" 
                            Foreground="#F8FAFC" 
                            CornerRadius="6" 
                            Padding="12,6"
                            ToolTip.Tip="Recarregar appsettings.json">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="12" />
                            <TextBlock Text="Recarregar Config" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Row="1" Margin="16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- DUAL VIEW: 70% ESQUERDA (CÂMERA PRINCIPAL + SOLIS) / 30% DIREITA (CÂMERA SECUNDÁRIA + WEATHER + MONITOR) -->
                <Grid IsVisible="{Binding IsDualView}" ColumnDefinitions="7*, 16, 3*">
                    
                    <!-- COLUNA ESQUERDA (70% DE LARGURA) -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        
                        <!-- CÂMERA PRINCIPAL (70% LARGURA - HEIGHT 410px) -->
                        <views:CameraView DataContext="{Binding PrimaryCamera}" />

                        <!-- PAINEL SOLIS (70% LARGURA - ABAIXO DA CÂMERA PRINCIPAL) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="18">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#F59E0B">
                                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="PAINEL SOLIS - INVERSOR &amp; TELEMETRIA (70%)" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="#F8FAFC" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#10B981" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="SOLIS CLOUD CONECTADO" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*, *, *">
                                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Modelo do Inversor" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SolisInverterModelText}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock Text="Solis S6 Single Phase" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Key ID &amp; Fuso" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SolisKeyIdText}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SolisTimeZoneText}" FontSize="11" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Endpoint API &amp; Moeda" FontSize="11" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SolisApiUrlText}" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SolisCurrencyText}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- COLUNA DIREITA (30% DE LARGURA) -->
                    <StackPanel Grid.Column="2" Spacing="16">
                        
                        <!-- CÂMERA SECUNDÁRIA (30% LARGURA - HEIGHT 180px) -->
                        <views:CameraView DataContext="{Binding SecondaryCamera}" />

                        <!-- PAINEL WEATHER (CLIMA - ABAIXO DA CÂMERA SECUNDÁRIA) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="16">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <!-- HEADER WEATHER -->
                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#0284C7">
                                            <TextBlock Text="🌤️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="CLIMA &amp; PREVISÃO" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,3">
                                            <TextBlock Text="{Binding WeatherProviderText}" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                        </Border>
                                        <Button Command="{Binding FetchWeatherCommand}" Background="#1E293B" Foreground="#F8FAFC" CornerRadius="4" Padding="6,2" ToolTip.Tip="Atualizar Clima">
                                            <TextBlock Text="🔄" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- LINHA 1: TEMPERATURA E UMIDADE ATUAIS NA MESMA LINHA -->
                                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WeatherIconEmoji}" FontSize="24" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <!-- TEMPERATURA -->
                                                    <TextBlock Text="{Binding WeatherCurrentTempText}" 
                                                               FontSize="18" 
                                                               FontWeight="Bold" 
                                                               Foreground="#F8FAFC" />
                                                    <TextBlock Text="|" FontSize="16" Foreground="#475569" Margin="2,0" />
                                                    <!-- UMIDADE -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="💧" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding WeatherCurrentHumidityText}" 
                                                                   FontSize="15" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="#38BDF8" 
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WeatherConditionText}" FontSize="11" Foreground="#94A3B8" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding WeatherLastUpdatedText}" 
                                                   FontSize="9" 
                                                   Foreground="#64748B" 
                                                   VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>

                                <!-- LINHA 2: MÁXIMA E MÍNIMA PARA OS PRÓXIMOS 4 DIAS -->
                                <StackPanel Grid.Row="2" Spacing="6">
                                    <TextBlock Text="PREVISÃO PRÓXIMOS 4 DIAS (MÁX / MÍN)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                    
                                    <ItemsControl ItemsSource="{Binding ForecastDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DailyForecast">
                                                <Border Background="#182030" 
                                                        BorderBrush="#263147" 
                                                        BorderThickness="1" 
                                                        CornerRadius="6" 
                                                        Padding="4,6" 
                                                        Margin="2">
                                                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding DayOfWeek}" 
                                                                   FontSize="10" 
                                                                   FontWeight="Bold" 
                                                                   Foreground="#F8FAFC" 
                                                                   HorizontalAlignment="Center" />
                                                        
                                                        <TextBlock Text="{Binding IconEmoji}" 
                                                                   FontSize="14" 
                                                                   HorizontalAlignment="Center" />

                                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding TempMax, StringFormat='{}{0:F0}°'}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#F97316" />
                                                            <TextBlock Text="/" FontSize="10" Foreground="#475569" />
                                                            <TextBlock Text="{Binding TempMin, StringFormat='{}{0:F0}°'}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#38BDF8" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- MONITOR DO SISTEMA (ABAIXO DO PAINEL WEATHER) -->
                        <Border Background="#131722" 
                                BorderBrush="#2A2E3D" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#7C3AED">
                                        <TextBlock Text="🖥️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="MONITOR DO SISTEMA" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">
                                    <Border Grid.Row="0" Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,4,4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Uso de Memória RAM" FontSize="10" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SysMemoryText}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="10" Margin="4,0,0,4">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Uptime App" FontSize="10" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SysUptimeText}" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,4,4,0">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Threads Ativas" FontSize="10" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SysThreadsText}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="10" Margin="4,4,0,0">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Plataforma OS" FontSize="10" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding SysOsText}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

                <!-- SINGLE EXPANDED CAMERA VIEW -->
                <Grid IsVisible="{Binding !IsDualView}">
                    <views:CameraView DataContext="{Binding FocusedCamera}" 
                                      VerticalAlignment="Stretch" 
                                      HorizontalAlignment="Stretch" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#0E121B" BorderBrush="#1F2433" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" 
                           Text="{Binding ConfigStatusMessage}" 
                           FontSize="12" 
                           Foreground="#94A3B8" 
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="[Ctrl+Enter] Tela Cheia | [ESC / Botão Direito] Sair" 
                                   FontSize="11" 
                                   Foreground="#38BDF8" 
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Config: appsettings.json" FontSize="11" Foreground="#64748B" />
                    <TextBlock Text="Framework: Avalonia .NET 10" FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
