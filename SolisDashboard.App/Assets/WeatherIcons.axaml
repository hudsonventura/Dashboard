<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Ícones climáticos SVG (geometrias vetoriais embutidas, domínio público / desenhos originais) -->

  <DrawingImage x:Key="Weather.clear">
    <DrawingGroup>
      <GeometryDrawing Brush="#F5B942"
                       Geometry="M12,4 A8,8 0 1 1 11.99,4 Z M12,0 L13.2,3.5 L12,2.8 L10.8,3.5 Z M12,21.2 L13.2,24 L12,23.2 L10.8,24 Z M0,12 L3.5,13.2 L2.8,12 L3.5,10.8 Z M21.2,12 L24,13.2 L23.2,12 L24,10.8 Z M3.5,3.5 L6.2,6.8 L5.2,5.2 L6.8,6.2 Z M17.8,17.8 L20.5,21.1 L19.5,19.5 L21.1,20.5 Z M3.5,20.5 L6.8,17.8 L5.2,18.8 L6.2,17.2 Z M17.8,6.2 L21.1,3.5 L19.5,4.5 L20.5,2.9 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.mainly-clear">
    <DrawingGroup>
      <GeometryDrawing Brush="#F5B942" Geometry="M8,6 A5,5 0 1 1 7.99,6 Z"/>
      <GeometryDrawing Brush="#D7DEE8" Geometry="M10,14 C10,11.5 12,10 14.5,10 C16.5,10 18,11 18.5,12.5 C20.5,12.7 22,14.2 22,16.2 C22,18.3 20.3,20 18.2,20 L11,20 C9.3,20 8,18.7 8,17 C8,15.5 9,14.2 10.4,14 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.partly-cloudy">
    <DrawingGroup>
      <GeometryDrawing Brush="#F5B942" Geometry="M6,5 A4.5,4.5 0 1 1 5.99,5 Z"/>
      <GeometryDrawing Brush="#C5D0DE" Geometry="M8,13 C8,10.8 10,9.2 12.5,9.2 C14.5,9.2 16.1,10.3 16.7,12 C18.8,12.2 20.5,13.9 20.5,16.1 C20.5,18.4 18.6,20.2 16.3,20.2 L9.2,20.2 C7.4,20.2 6,18.8 6,17 C6,15.4 7.1,14.1 8.6,13.2 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.overcast">
    <DrawingGroup>
      <GeometryDrawing Brush="#9AA8B8" Geometry="M4,14 C4,11.2 6.4,9.2 9.2,9.2 C11.2,9.2 12.9,10.2 13.7,11.7 C16.2,11.5 18.5,13.4 18.5,16 C18.5,18.5 16.5,20.5 14,20.5 L6.5,20.5 C5.1,20.5 4,19.4 4,18 Z"/>
      <GeometryDrawing Brush="#B7C3D1" Geometry="M7,11 C7,8.8 9,7 11.5,7 C13.4,7 15,8 15.7,9.5 C17.8,9.7 19.5,11.4 19.5,13.6 C19.5,15.9 17.6,17.7 15.3,17.7 L8.5,17.7 C7,17.7 5.8,16.5 5.8,15 C5.8,13.5 6.8,12.2 8.2,11.4 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.fog">
    <DrawingGroup>
      <GeometryDrawing Brush="#AEB8C4" Geometry="M3,9 L21,9 L21,11 L3,11 Z M5,13 L19,13 L19,15 L5,15 Z M4,17 L20,17 L20,19 L4,19 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.drizzle">
    <DrawingGroup>
      <GeometryDrawing Brush="#B7C3D1" Geometry="M6,8 C6,5.5 8.2,3.8 10.8,3.8 C12.8,3.8 14.4,4.9 15.1,6.5 C17.4,6.7 19.2,8.6 19.2,11 C19.2,13.5 17.2,15.5 14.7,15.5 L7.8,15.5 C6.3,15.5 5,14.2 5,12.7 C5,10.9 5.9,9.4 7.3,8.6 Z"/>
      <GeometryDrawing Brush="#4EA0D8" Geometry="M8,17 L9,20 M12,17 L13,20 M16,17 L17,20" Pen="{x:Null}"/>
      <GeometryDrawing Geometry="M8,17 L9,21 M12,17 L13,21 M16,17 L17,21">
        <GeometryDrawing.Pen>
          <Pen Brush="#4EA0D8" Thickness="1.6" LineCap="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.rain">
    <DrawingGroup>
      <GeometryDrawing Brush="#8FA0B3" Geometry="M5,7 C5,4.2 7.5,2.2 10.5,2.2 C12.7,2.2 14.5,3.4 15.3,5.2 C17.9,5.4 20,7.5 20,10.2 C20,13 17.7,15.2 14.9,15.2 L7.2,15.2 C5.8,15.2 4.5,13.9 4.5,12.5 C4.5,10.5 5.6,8.8 7.2,8 Z"/>
      <GeometryDrawing Geometry="M7,17 L8.2,22 M11,17 L12.2,22 M15,17 L16.2,22">
        <GeometryDrawing.Pen>
          <Pen Brush="#2F7DBA" Thickness="2" LineCap="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.showers">
    <DrawingGroup>
      <GeometryDrawing Brush="#7F93A8" Geometry="M5,6.5 C5,3.8 7.5,1.8 10.5,1.8 C12.7,1.8 14.5,3 15.3,4.8 C17.9,5 20,7.1 20,9.8 C20,12.6 17.7,14.8 14.9,14.8 L7.2,14.8 C5.8,14.8 4.5,13.5 4.5,12.1 C4.5,10.1 5.6,8.4 7.2,7.6 Z"/>
      <GeometryDrawing Geometry="M8,16 L7,21 M12,16 L11,21 M16,16 L15,21">
        <GeometryDrawing.Pen>
          <Pen Brush="#2F7DBA" Thickness="2.2" LineCap="Round"/>
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.snow">
    <DrawingGroup>
      <GeometryDrawing Brush="#B7C3D1" Geometry="M5,7 C5,4.2 7.5,2.2 10.5,2.2 C12.7,2.2 14.5,3.4 15.3,5.2 C17.9,5.4 20,7.5 20,10.2 C20,13 17.7,15.2 14.9,15.2 L7.2,15.2 C5.8,15.2 4.5,13.9 4.5,12.5 C4.5,10.5 5.6,8.8 7.2,8 Z"/>
      <GeometryDrawing Brush="#E8F2FA" Geometry="M8,18 A1.2,1.2 0 1 1 7.99,18 Z M12,20 A1.2,1.2 0 1 1 11.99,20 Z M16,18 A1.2,1.2 0 1 1 15.99,18 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.thunder">
    <DrawingGroup>
      <GeometryDrawing Brush="#6E7F93" Geometry="M5,6 C5,3.3 7.5,1.4 10.5,1.4 C12.7,1.4 14.5,2.6 15.3,4.4 C17.9,4.6 20,6.7 20,9.4 C20,12.2 17.7,14.4 14.9,14.4 L7.2,14.4 C5.8,14.4 4.5,13.1 4.5,11.7 C4.5,9.7 5.6,8 7.2,7.2 Z"/>
      <GeometryDrawing Brush="#F5B942" Geometry="M13,13 L10,19 L12.2,19 L11,24 L16,16.5 L13.5,16.5 Z"/>
    </DrawingGroup>
  </DrawingImage>

  <DrawingImage x:Key="Weather.unknown">
    <DrawingGroup>
      <GeometryDrawing Brush="#8A95A3" Geometry="M12,3 A9,9 0 1 1 11.99,3 Z"/>
      <GeometryDrawing Brush="#1B2430" Geometry="M11,8 L13,8 L13,14 L11,14 Z M11,16 L13,16 L13,18 L11,18 Z"/>
    </DrawingGroup>
  </DrawingImage>

</ResourceDictionary>
