<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SolisDashboard.App.ViewModels"
        xmlns:models="using:SolisDashboard.App.Models"
        xmlns:conv="using:SolisDashboard.App.Converters"
        xmlns:display="using:SolisDashboard.App.Display"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="SolisDashboard.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Solis Dashboard"
        Width="1280" Height="720"
        MinWidth="1280" MinHeight="720"
        WindowState="FullScreen"
        Background="{DynamicResource AppBg}">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    </Style>
    <Style Selector="TextBlock.metric-value">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ProgressBar.sys">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="ProgressBar.sys-critical">
      <Style.Animations>
        <Animation Duration="0:0:0.45" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.25" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Panel>
  <!-- Layout 16:9 — esquerda ~30% | direita ~70% -->
  <Grid Margin="10" ColumnDefinitions="3*,7*" ColumnSpacing="10">

    <!-- ===== COLUNA ESQUERDA ===== -->
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="8">

      <!-- Câmera secundária — Height via appsettings Cameras.Secondary.Height -->
      <Border Grid.Row="0" Classes="card" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Margin="0,0,0,4"
                     Text="{Binding SecondaryCameraName, StringFormat=Câmera secundária · {0}}" />
          <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="36" Margin="0,4,0,0"
                        IsVisible="{Binding CameraStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding CameraStatus}" FontSize="10"
                       Foreground="#E57373" TextWrapping="Wrap" />
          </ScrollViewer>
          <Border Height="{Binding SecondaryCameraHeight}"
                  Background="#0D1117" CornerRadius="6" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding SecondaryCameraFrame}"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
              <TextBlock Text="Sem vídeo"
                         IsVisible="{Binding SecondaryCameraFrame, Converter={x:Static ObjectConverters.IsNull}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedText}" />
            </Panel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Weather compacto (Auto — sobra altura para Sistema) -->
      <Border Grid.Row="1" Classes="card" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Margin="0,0,0,4"
                     Text="{Binding WeatherProviderLabel}" />

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
              <Image Width="32" Height="32" VerticalAlignment="Center"
                     Source="{Binding WeatherIconKey, Converter={x:Static conv:WeatherIconConverter.Instance}}" />
              <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding WeatherTemp}" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" />
                <TextBlock Text="{Binding WeatherCondition}" FontSize="10"
                           Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                <TextBlock Classes="metric-label" Text="Máx / Mín" />
                <TextBlock Classes="metric-value" FontSize="11" Text="{Binding WeatherTodayRange}" />
              </StackPanel>
              <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="0">
                <TextBlock Classes="metric-label" Text="Umidade" />
                <TextBlock Classes="metric-value" FontSize="11" Text="{Binding WeatherHumidity}" />
              </StackPanel>
              <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="0">
                <TextBlock Classes="metric-label" Text="Vento" />
                <TextBlock Classes="metric-value" FontSize="11" Text="{Binding WeatherWind}" />
              </StackPanel>
              <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="0">
                <TextBlock Classes="metric-label" Text="Chuva" />
                <TextBlock Classes="metric-value" FontSize="11" Text="{Binding WeatherPrecip}" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding ForecastDays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ForecastDayItem">
                  <Border Margin="1,0" Padding="3,4" CornerRadius="6" Background="#14FFFFFF">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding DateLabel}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryText}"
                                 HorizontalAlignment="Center" />
                      <Image Width="22" Height="22" HorizontalAlignment="Center"
                             Source="{Binding IconKey, Converter={x:Static conv:WeatherIconConverter.Instance}}" />
                      <TextBlock Text="{Binding TempRange}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryText}"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Sistema (htop) -->
      <Border Grid.Row="2" Classes="card" Padding="10">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock Classes="section" Text="Sistema" Margin="0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SystemPlatform}" FontSize="10"
                       Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
          </Grid>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Classes="metric-label" Text="Processadores" />
              <ItemsControl ItemsSource="{Binding CpuCores}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:CpuCoreItem">
                    <Grid ColumnDefinitions="48,*,44" ColumnSpacing="6" Margin="0,0,0,4">
                      <TextBlock Text="{Binding Name}" FontSize="11"
                                 Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="1" Classes="sys"
                                   Value="{Binding UsagePercent}"
                                   Foreground="{Binding BarBrush}"
                                   Classes.sys-critical="{Binding IsCritical}"
                                   VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding UsageText}" FontSize="11"
                                 Foreground="{DynamicResource PrimaryText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="metric-label" Text="Memória" />
                  <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="11"
                             Foreground="{DynamicResource PrimaryText}" />
                </Grid>
                <ProgressBar Classes="sys"
                             Value="{Binding MemoryPercent}"
                             Foreground="{Binding MemoryBarBrush}"
                             Classes.sys-critical="{Binding MemoryIsCritical}" />
              </StackPanel>

              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="metric-label" Text="Swap" />
                  <TextBlock Grid.Column="1" Text="{Binding SwapText}" FontSize="11"
                             Foreground="#EF5350" />
                </Grid>
                <ProgressBar Classes="sys"
                             Value="{Binding SwapPercent}"
                             Foreground="{x:Static display:UsageBarPalette.SwapRed}" />
              </StackPanel>

              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Classes="metric-label" Text="Temp. CPU" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CpuTempText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===== COLUNA DIREITA ===== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

      <!-- Câmera principal — Height via appsettings Cameras.Primary.Height -->
      <Border Grid.Row="0" Classes="card" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Margin="0,0,0,4"
                     Text="{Binding PrimaryCameraName, StringFormat=Câmera principal · {0}}" />
          <Border Height="{Binding PrimaryCameraHeight}"
                  Background="#0D1117" CornerRadius="6" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding PrimaryCameraFrame}"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
              <TextBlock Text="Sem vídeo"
                         IsVisible="{Binding PrimaryCameraFrame, Converter={x:Static ObjectConverters.IsNull}}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedText}" />
            </Panel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Solis: métricas à esquerda + gráfico menor à direita -->
      <Border Grid.Row="1" Classes="card" Padding="10">
        <Grid ColumnDefinitions="42*,58*" ColumnSpacing="10">

          <!-- Propriedades / métricas — Grid Auto garante relógio sempre visível -->
          <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="section" Text="Solis Inversor" Margin="0" />
                <TextBlock FontSize="11" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap">
                  <Run Text="{Binding ModelText}" FontWeight="SemiBold" />
                  <Run Text=" · " />
                  <Run Text="{Binding StateText}" />
                </TextBlock>
                <TextBlock FontSize="10" Foreground="{DynamicResource MutedText}" Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" MaxWidth="200" />
                <TextBlock FontSize="10" Foreground="#E57373" Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap" MaxWidth="200" MaxHeight="32" TextTrimming="CharacterEllipsis" />
              </StackPanel>

              <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="Geração" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedText}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EnergyTodayText}" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Top">
                <Button Content="Atualizar" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}"
                        Padding="10,6" Background="{DynamicResource Accent}" Foreground="#1A1F26"
                        FontWeight="SemiBold" CornerRadius="8" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding CountdownText}" FontSize="9"
                           Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding UpdatedText}" FontSize="9"
                           Foreground="{DynamicResource MutedText}" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="6">
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <Border Classes="metric">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="metric-label" Text="PV1" />
                    <TextBlock Classes="metric-value" Foreground="{DynamicResource Accent}" Text="{Binding Pv1Power}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedText}" Text="{Binding Pv1Voltage}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedText}" Text="{Binding Pv1Current}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="metric-label" Text="PV2" />
                    <TextBlock Classes="metric-value" Foreground="{DynamicResource Accent}" Text="{Binding Pv2Power}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedText}" Text="{Binding Pv2Voltage}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedText}" Text="{Binding Pv2Current}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="metric">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="metric-label" Text="AC Potência" />
                    <TextBlock Classes="metric-value" Foreground="{DynamicResource Accent}" Text="{Binding AcPower}" />
                    <TextBlock FontSize="10" Foreground="{DynamicResource MutedText}" Text="{Binding AcCurrent}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Border Classes="metric">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="metric-label" Text="IGBT" />
                    <TextBlock Classes="metric-value" FontSize="13" Text="{Binding IgbtTemp}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="metric-label" Text="Temp. inversor" />
                    <TextBlock Classes="metric-value" Text="{Binding InverterTemp}" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <!-- Relógio + 6 kW: linha Auto, sempre acima do limite do card -->
            <Border Grid.Row="2" Classes="metric" Padding="8,6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Spacing="0">
                  <TextBlock Text="{Binding ClockDateText}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryText}"
                             FontFamily="Consolas, monospace" />
                  <TextBlock Text="{Binding ClockTimeText}" FontSize="22" FontWeight="Bold"
                             Foreground="{DynamicResource Accent}"
                             FontFamily="Consolas, monospace" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                  <TextBlock Classes="metric-label" Text="1º ≥ 6 kW" />
                  <TextBlock FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}"
                             Text="{Binding Power6kFirstText}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="0">
                  <TextBlock Classes="metric-label" Text="Último ≥ 6 kW" />
                  <TextBlock FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}"
                             Text="{Binding Power6kLastText}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- Gráfico compacto -->
          <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{DynamicResource MutedText}"
                       Text="{Binding ChartPeakText}" Margin="0,0,0,4" />
            <lvc:CartesianChart Series="{Binding ChartSeries}"
                                XAxes="{Binding XAxes}"
                                YAxes="{Binding YAxes}"
                                LegendPosition="Hidden"
                                ZoomMode="X" />
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>

    <!-- Botão de alerta (não obstrui o dashboard) -->
    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,16,0" Width="44" Height="44" Padding="0"
            CornerRadius="22" Background="#C62828" BorderThickness="0"
            ToolTip.Tip="Ver erros"
            IsVisible="{Binding HasDiagnosticLog}"
            Command="{Binding ToggleDiagnosticCommand}"
            ZIndex="20">
      <Panel Width="24" Height="24">
        <Path Width="22" Height="20" Stretch="Uniform" Fill="#FFEBEE"
              Data="M12,2 L23,21 H1 Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Text="!" FontSize="14" FontWeight="Bold" Foreground="#C62828"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" />
      </Panel>
    </Button>

    <!-- Painel de erros ao abrir o alerta -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,68,16,16" Width="520" MaxHeight="360"
            Background="#CC1A1F26" BorderBrush="#E57373" BorderThickness="1"
            CornerRadius="10" Padding="12" ZIndex="21"
            IsVisible="{Binding IsDiagnosticPanelOpen}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
          <TextBlock Text="Erros" FontWeight="SemiBold" Foreground="#FFCDD2"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding CopyDiagnosticStatus}" FontSize="10"
                     Foreground="#A5D6A7" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Grid.Column="2" Content="Copiar" Command="{Binding CopyDiagnosticCommand}"
                  Padding="10,4" FontSize="11" />
          <Button Grid.Column="3" Content="Fechar" Command="{Binding CloseDiagnosticCommand}"
                  Padding="10,4" FontSize="11" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LogFilePath, StringFormat=Log: {0}}"
                   FontSize="10" Foreground="#FFCDD2" Margin="0,8,0,0" TextWrapping="Wrap" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding DiagnosticLog}" FontSize="11" FontFamily="Consolas, monospace"
                     Foreground="#FFEBEE" TextWrapping="Wrap" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</Window>
